{
  "id": "com.dj.quantizer",
  "name": "Quantizer",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Utilities",
  "inputs": [
    { "id": "in", "name": "Pitch In", "default": 0.0,
      "knob": { "style": "continuous", "min": -5.0, "max": 5.0, "curve": "linear" } },
    { "id": "scale", "name": "Scale", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 9.0, "curve": "linear", "steps": 10 },
      "display": { "steps": ["custom", "major", "minor", "harm minor", "penta maj",
                             "penta min", "blues", "dorian", "mixolydian", "whole tone"] } },
    { "id": "root", "name": "Root", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 11.0, "curve": "linear", "steps": 12 },
      "display": { "steps": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"] } },
    { "id": "semitones", "name": "Transpose (semi)", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 12.0, "curve": "linear", "steps": 13 },
      "display": { "unit": "st" } },
    { "id": "octaves", "name": "Transpose (oct)", "default": 0.0,
      "knob": { "style": "stepped", "min": -4.0, "max": 4.0, "curve": "linear", "steps": 9 },
      "display": { "unit": "oct" } },
    { "id": "custom", "name": "Custom Scale", "default": 4095.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 4095.0, "curve": "linear" } }
  ],
  "outputs": [
    { "id": "out", "name": "Pitch Out" },
    { "id": "trig", "name": "Trigger" }
  ],
  "params": [],
  "latency_samples": 0
}
