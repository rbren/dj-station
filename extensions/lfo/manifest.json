{
  "id": "com.dj.lfo",
  "name": "LFO",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Modulation",
  "inputs": [
    { "id": "rate", "name": "Rate", "default": 2.0,
      "knob": { "style": "continuous", "min": 0.01, "max": 2000.0, "curve": "exp" },
      "display": { "unit": "Hz" } },
    { "id": "shape", "name": "Shape", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 6.0, "curve": "linear", "steps": 7 },
      "display": { "steps": ["sine", "tri", "saw ↑", "saw ↓", "pulse", "s&h", "smooth"] } },
    { "id": "pw", "name": "Pulse Width", "default": 0.5,
      "knob": { "style": "continuous", "min": 0.02, "max": 0.98, "curve": "linear" },
      "display": { "unit": "" } },
    { "id": "clock", "name": "Clock", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "ratio", "name": "Mult / Div", "default": 4.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 8.0, "curve": "linear", "steps": 9 },
      "display": { "steps": ["/8", "/4", "/3", "/2", "x1", "x2", "x3", "x4", "x8"] } },
    { "id": "reset", "name": "Reset", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "phase", "name": "Phase", "default": 0.25,
      "knob": { "style": "continuous", "min": 0.0, "max": 1.0, "curve": "linear" },
      "display": { "unit": "cyc" } }
  ],
  "outputs": [
    { "id": "bi", "name": "Bipolar" },
    { "id": "uni", "name": "Unipolar" },
    { "id": "shifted", "name": "Phase Shifted" }
  ],
  "latency_samples": 0
}
