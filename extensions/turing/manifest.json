{
  "id": "com.dj.turing",
  "name": "Random CV",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Clock & Sequencing",
  "inputs": [
    { "id": "clock", "name": "Clock", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "prob", "name": "Probability", "default": 0.5,
      "knob": { "style": "continuous", "min": 0.0, "max": 1.0, "curve": "linear" } },
    { "id": "length", "name": "Length", "default": 8.0,
      "knob": { "style": "stepped", "min": 1.0, "max": 16.0, "curve": "linear", "steps": 16 } },
    { "id": "range", "name": "Range", "default": 2.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "scale", "name": "Scale", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 9.0, "curve": "linear", "steps": 10 } },
    { "id": "root", "name": "Root", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 11.0, "curve": "linear", "steps": 12 } }
  ],
  "outputs": [
    { "id": "cv", "name": "CV" },
    { "id": "bit1", "name": "Bit 1" },
    { "id": "bit2", "name": "Bit 2" },
    { "id": "quant", "name": "Quantized" }
  ],
  "latency_samples": 0
}
