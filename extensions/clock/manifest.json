{
  "id": "com.dj.clock",
  "name": "Clock",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Clock & Sequencing",
  "inputs": [
    { "id": "bpm", "name": "BPM", "default": 120.0,
      "knob": { "style": "continuous", "min": 20.0, "max": 300.0, "curve": "linear" },
      "display": { "unit": "BPM" } },
    { "id": "run", "name": "Run", "default": 10.0,
      "knob": { "style": "switch", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "reset", "name": "Reset", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "swing", "name": "Swing", "default": 0.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 1.0, "curve": "linear" } },
    { "id": "beats", "name": "Beats/Bar", "default": 4.0,
      "knob": { "style": "stepped", "min": 1.0, "max": 16.0, "curve": "linear", "steps": 16 } }
  ],
  "outputs": [
    { "id": "clock", "name": "Clock" },
    { "id": "div2", "name": "/2" },
    { "id": "div4", "name": "/4" },
    { "id": "div8", "name": "/8" },
    { "id": "div16", "name": "/16" },
    { "id": "mul2", "name": "x2" },
    { "id": "mul3", "name": "x3" },
    { "id": "mul4", "name": "x4" },
    { "id": "bar", "name": "Bar" }
  ],
  "latency_samples": 0
}
