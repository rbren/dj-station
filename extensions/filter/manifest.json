{
  "id": "com.dj.filter",
  "name": "Filter",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Shaping",
  "inputs": [
    { "id": "in", "name": "In", "default": 0.0 },
    { "id": "cutoff", "name": "Cutoff", "default": 1.0,
      "knob": { "style": "continuous", "min": -6.0, "max": 6.0, "curve": "linear" },
      "display": { "unit": "Hz", "map": { "kind": "volt_per_octave" } } },
    { "id": "res", "name": "Resonance", "default": 0.15,
      "knob": { "style": "continuous", "min": 0.0, "max": 1.0, "curve": "linear" },
      "display": { "unit": "" } },
    { "id": "drive", "name": "Drive", "default": 1.0,
      "knob": { "style": "continuous", "min": 0.1, "max": 10.0, "curve": "exp" },
      "display": { "unit": "x" } },
    { "id": "topology", "name": "Topology", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 2.0, "curve": "linear", "steps": 3 },
      "display": { "steps": ["SVF", "ladder", "OTA"] } }
  ],
  "outputs": [
    { "id": "lp", "name": "LP" },
    { "id": "bp", "name": "BP" },
    { "id": "hp", "name": "HP" },
    { "id": "notch", "name": "Notch" }
  ],
  "bypass": { "lp": "in", "bp": "in", "hp": "in", "notch": "in" },
  "latency_samples": 0
}
