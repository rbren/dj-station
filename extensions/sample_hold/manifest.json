{
  "id": "com.dj.sample_hold",
  "name": "Sample & Hold",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Modulation",
  "inputs": [
    { "id": "in", "name": "In", "default": 0.0 },
    { "id": "trig", "name": "Trigger", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "mode", "name": "Mode", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 1.0, "curve": "linear", "steps": 2 },
      "display": { "steps": ["sample", "track"] } },
    { "id": "slew", "name": "Slew", "default": 0.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 1.0, "curve": "exp" },
      "display": { "unit": "s" } }
  ],
  "outputs": [
    { "id": "out", "name": "Out" },
    { "id": "noise", "name": "Noise" }
  ],
  "latency_samples": 0
}
