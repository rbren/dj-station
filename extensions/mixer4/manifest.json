      "knob": { "style": "switch", "min": 0.0, "max": 10.0, "curve": "linear" } },

    { "id": "in3_l", "name": "In 3 L", "default": 0.0, "audio": true },
    { "id": "in3_r", "name": "In 3 R", "default": 0.0, "audio": true },
    { "id": "lvl3", "name": "Level 3", "default": 8.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "pan3", "name": "Pan 3", "default": 0.0,
      "knob": { "style": "continuous", "min": -10.0, "max": 10.0, "curve": "linear" } },
    { "id": "mute3", "name": "Mute 3", "default": 0.0,
      "knob": { "style": "switch", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "solo3", "name": "Solo 3", "default": 0.0,
      "knob": { "style": "switch", "min": 0.0, "max": 10.0, "curve": "linear" } },

    { "id": "in4_l", "name": "In 4 L", "default": 0.0, "audio": true },
    { "id": "in4_r", "name": "In 4 R", "default": 0.0, "audio": true },
    { "id": "lvl4", "name": "Level 4", "default": 8.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "pan4", "name": "Pan 4", "default": 0.0,
      "knob": { "style": "continuous", "min": -10.0, "max": 10.0, "curve": "linear" } },
