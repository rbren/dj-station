{
  "id": "com.dj.mixer4",
  "name": "Mixer 4",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Utilities",
  "inputs": [
    { "id": "in1_l", "name": "In 1 L", "default": 0.0, "audio": true },
    { "id": "in1_r", "name": "In 1 R", "default": 0.0, "audio": true },
    { "id": "lvl1", "name": "Level 1", "default": 8.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "pan1", "name": "Pan 1", "default": 0.0,
      "knob": { "style": "continuous", "min": -10.0, "max": 10.0, "curve": "linear" } },
    { "id": "mute1", "name": "Mute 1", "default": 0.0,
      "knob": { "style": "switch", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "solo1", "name": "Solo 1", "default": 0.0,
      "knob": { "style": "switch", "min": 0.0, "max": 10.0, "curve": "linear" } },

    { "id": "in2_l", "name": "In 2 L", "default": 0.0, "audio": true },
    { "id": "in2_r", "name": "In 2 R", "default": 0.0, "audio": true },
