{
  "id": "com.dj.adsr",
  "name": "ADSR",
  "version": "0.1.0",
  "abi": "wasm-1",
  "inputs": [
    { "id": "gate", "name": "Gate", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "retrig", "name": "Retrig", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } }
  ],
  "outputs": [
    { "id": "env", "name": "Env" }
  ],
  "params": [
    { "id": "attack", "name": "Attack", "type": "float", "default": 0.01, "min": 0.0005, "max": 5.0 },
    { "id": "decay", "name": "Decay", "type": "float", "default": 0.1, "min": 0.001, "max": 5.0 },
    { "id": "sustain", "name": "Sustain", "type": "float", "default": 0.7, "min": 0.0, "max": 1.0 },
    { "id": "release", "name": "Release", "type": "float", "default": 0.2, "min": 0.001, "max": 10.0 }
  ],
  "ui": "ui.js",
  "latency_samples": 0
}
