  "outputs": [
    { "id": "a1", "name": "A 1" },
    { "id": "a2", "name": "A 2" },
    { "id": "a3", "name": "A 3" },
    { "id": "a4", "name": "A 4" },
    { "id": "b1", "name": "B 1" },
    { "id": "b2", "name": "B 2" },
    { "id": "b3", "name": "B 3" },
    { "id": "b4", "name": "B 4" },
    { "id": "merge", "name": "Merge Out" },
    { "id": "s1", "name": "Split 1" },
    { "id": "s2", "name": "Split 2" },
    { "id": "s3", "name": "Split 3" },
    { "id": "s4", "name": "Split 4" }
  ],
  "params": [],
  "latency_samples": 0
