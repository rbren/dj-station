{
  "id": "com.dj.mult",
  "name": "Mult / Merge / Split",
  "version": "0.1.0",
  "abi": "wasm-1",
  "category": "Utilities",
  "inputs": [
    { "id": "a_in", "name": "Mult A In", "default": 0.0 },
    { "id": "b_in", "name": "Mult B In (norm A)", "default": 0.0 },
    { "id": "merge1", "name": "Merge 1", "default": 0.0 },
    { "id": "merge2", "name": "Merge 2", "default": 0.0 },
    { "id": "merge3", "name": "Merge 3", "default": 0.0 },
    { "id": "merge4", "name": "Merge 4", "default": 0.0 },
    { "id": "split_in", "name": "Split In", "default": 0.0 },
    { "id": "split_sel", "name": "Split Select", "default": 0.0,
