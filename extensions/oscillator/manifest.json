{
  "id": "com.dj.oscillator",
  "name": "Oscillator",
  "version": "0.1.0",
  "abi": "wasm-1",
  "inputs": [
    { "id": "pitch", "name": "Pitch", "default": 0.0,
      "knob": { "style": "continuous", "min": -5.0, "max": 5.0, "curve": "linear" } },
    { "id": "fm", "name": "FM", "default": 0.0,
      "knob": { "style": "continuous", "min": -5.0, "max": 5.0, "curve": "linear" } },
    { "id": "sync", "name": "Sync", "default": 0.0,
      "knob": { "style": "button", "min": 0.0, "max": 10.0, "curve": "linear" } },
    { "id": "waveform", "name": "Waveform", "default": 0.0,
      "knob": { "style": "stepped", "min": 0.0, "max": 3.0, "curve": "linear", "steps": 4 } }
  ],
  "outputs": [
    { "id": "audio", "name": "Audio" }
  ],
  "latency_samples": 0
}
