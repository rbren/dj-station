{
  "id": "com.dj.gain_native",
  "name": "Gain (Native)",
  "version": "0.1.0",
  "abi": "native-1",
  "category": "Utilities",
  "inputs": [
    { "id": "in", "name": "In", "default": 0.0 },
    { "id": "gain", "name": "Gain / CV", "default": 10.0,
      "knob": { "style": "continuous", "min": 0.0, "max": 10.0, "curve": "linear" } }
  ],
  "outputs": [
    { "id": "out", "name": "Out" }
  ],
  "params": [
    { "id": "boost", "name": "Boost", "type": "float", "default": 1.0, "min": 0.0, "max": 4.0 }
  ],
  "latency_samples": 0
}
