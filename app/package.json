{
  "name": "dj-station-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:extension-uis",
    "build:extension-uis": "esbuild ../extensions/adsr/ui-src/AdsrUI.tsx --bundle --format=esm --external:react --external:react/jsx-runtime --outfile=../extensions/adsr/ui.js",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint . && prettier --check src tests ../extensions/adsr/ui-src",
    "format": "prettier --write src tests ../extensions/adsr/ui-src"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
